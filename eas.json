{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_PAYMENT_PROVIDER": "razorpay"
      }
    },
    "e2e-test": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "test"
      },
      "withoutCredentials": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    }
  }
}
